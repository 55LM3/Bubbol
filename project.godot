; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bubbol! Client"
run/main_scene="uid://ddknkjprd61jc"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://dplrx8whcsblr"
config/icon="uid://cul8gw5c244dm"
config/windows_native_icon="res://textures/icon/BubbolIcon1.ico"

[autoload]

Global="*uid://d4ellnmdbv16f"
DiscordRPCLoader="*uid://n2we65ba5uaw"
BubbolscriptRuntime="*uid://hck6hoj8uw3l"

[display]

window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/discord-rpc-gd/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg")

